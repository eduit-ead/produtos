# Configuração de exemplo — nunca commite valores reais de segredos.

# Servidor
HOST=127.0.0.1
PORT=3000

# Provedor de armazenamento: local (padrão) ou futuro s3/supabase
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./output/ai-catalog
AI_CATALOG_DIR=./output/ai-catalog

# Chave da OpenAI para geração de imagens reais.
# Preencha no .env local; deixe vazio ou placeholder para dry-run.
OPENAI_API_KEY=sk-...

# Variáveis reservadas para futuros provedores (não utilizadas no modo local).
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_SUPABASE_URL=
# STORAGE_SUPABASE_SERVICE_ROLE_KEY=
