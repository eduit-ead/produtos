# Exemplo de configuração. Não coloque segredos reais neste arquivo.

# Servidor
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Raiz dos arquivos que precisam sobreviver a reinícios.
# Desenvolvimento: diretório do projeto. Docker/Easypanel: /app/persistent
APP_RUNTIME_DIR=.

# Autenticação. Nesta fase pode permanecer desativada.
# Em NODE_ENV=production o servidor exige senha e segredo, salvo AUTH_DISABLED=true.
AUTH_DISABLED=true
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=

# Armazenamento local. Caminhos relativos valem no Windows.
# No contêiner, omita ou aponte para /app/persistent/output/ai-catalog.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./output/ai-catalog
AI_CATALOG_DIR=./output/ai-catalog

# OpenAI. Preencha somente no .env local ou no painel do Easypanel.
OPENAI_API_KEY=

# Reservado para storage S3. Não usado com STORAGE_PROVIDER=local.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Reservado para uma fase futura. A aplicação ainda não conecta ao banco.
DATABASE_URL=postgres://user:password@postgres:5432/bwipoart
