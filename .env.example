# Configuração de exemplo — nunca commite valores reais de segredos.

# Servidor
HOST=127.0.0.1
PORT=3000

# Diretório base de runtime. Em Docker deve ser um volume persistente.
# Use "." para manter dados no diretório do projeto; em produção use /app/data.
APP_RUNTIME_DIR=.

# Autenticação opcional. Defina APP_ACCESS_PASSWORD para exigir login.
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=altere-para-um-segredo-longo-e-aleatorio
AUTH_DISABLED=false

# Provedor de armazenamento: local (padrão) ou futuro s3/supabase
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./output/ai-catalog
AI_CATALOG_DIR=./output/ai-catalog

# Chave da OpenAI para geração de imagens reais.
# Preencha no .env local; deixe vazia ou placeholder para dry-run.
OPENAI_API_KEY=sk-...

# Variáveis reservadas para storage S3 (não utilizadas no modo local).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Variáveis reservadas para storage Supabase (não utilizadas no modo local).
STORAGE_SUPABASE_URL=
STORAGE_SUPABASE_SERVICE_ROLE_KEY=
